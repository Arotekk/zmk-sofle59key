#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define ADJUST 3

&mt {
    tapping-term-ms = <150>;
    flavor = "tap-preferred";
    bindings = <&kp>, <&kp>;
};

&lt { tapping-term-ms = <150>; };

/ {
    // Activate ADJUST layer by pressing raise and lower

    conditional_layers { compatible = "zmk,conditional-layers"; };

    combos {
        compatible = "zmk,combos";

        KlammerAuf {
            bindings = <&kp LS(NUMBER_8)>;
            key-positions = <54 28>;
        };

        kleiner {
            bindings = <&kp NON_US_BACKSLASH>;
            key-positions = <54 26>;
        };

        eckigAuf {
            bindings = <&kp LA(LC(NUMBER_7))>;
            key-positions = <54 27>;
        };

        geschweiftAuf {
            bindings = <&kp LA(LC(NUMBER_8))>;
            key-positions = <54 25>;
        };

        KlammerZu {
            bindings = <&kp LS(NUMBER_9)>;
            key-positions = <55 31>;
        };

        groeser {
            bindings = <&kp LS(NON_US_BACKSLASH)>;
            key-positions = <55 33>;
        };

        eckigZu {
            bindings = <&kp LA(LC(NUMBER_0))>;
            key-positions = <55 32>;
        };

        geschweiftZu {
            bindings = <&kp LA(LC(NUMBER_9))>;
            key-positions = <55 34>;
        };
    };

    macros {
        aoeStart: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kt H &kp Q &kp Q &kp Q>;
            label = "NEW_MACRO";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // swap C_MUTE & EQUAL for encoder on the right

        default {
            display-name = "default";

            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |       |
            // |  ESC  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   | BKSPC |
            // |  TAB  |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  MUTE  |  |       |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //               | GUI | ALT  | CTRL | LOWER|  ENTER |  | SPACE | RAISE| CTRL  | ALT   | GUI  |

            bindings = <
&gresc        &kp N1         &kp N2          &kp N3              &kp N4              &kp N5                                      &kp N6     &kp N7             &kp N8              &kp N9          &kp N0   &none
&kp ESCAPE    &kp X          &kp V           &kp L               &kp C               &kp W                                       &kp K      &kp H              &kp G               &kp F           &kp Q    &kp MINUS
&kp TAB       &lt 1 U        &mt LEFT_ALT I  &mt LEFT_CONTROL A  &mt LEFT_SHIFT E    &kp O                                       &kp S      &mt LEFT_SHIFT N   &mt LEFT_CONTROL R  &mt LEFT_ALT T  &lt 1 D  &kp LEFT_BRACKET
&kp LEFT_GUI  &kp SEMICOLON  &kp Z           &kp SINGLE_QUOTE    &kp P               &kp Y          &kp C_MUTE      &tog 4       &kp B      &kp M              &kp COMMA           &kp DOT         &kp J    &kp SLASH
                             &none           &none               &mt LEFT_ALT TILDE  &kp BACKSPACE  &lt 2 DELETE    &lt 3 SPACE  &kp ENTER  &kp LA(LC(ENTER))  &none               &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        Zeichen {
            display-name = "sign";

            // TODO: Some binds are waiting for shifted keycode support.
            // ------------------------------------------------------------------------------------------------------------
            // |       |  F1 |  F2 |  F3  |  F4  |  F5  |                   |  F6  |  F7   |  F8   |  F9  |  F10  |  F11  |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  F12  |
            // |       |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   |   |
            // |       |  =  |  -  |  +   |  {   |  }   |        |  |       |  [   |  ]    |  ;    |  :   |   \   |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&trans  &none      &none          &none                  &none              &none                     &none            &none             &none                         &none             &none  &none
&trans  &kp GRAVE  &kp LS(GRAVE)  &kp LA(LC(Q))          &kp LS(NUMBER_4)   &none                     &none            &kp LS(NUMBER_6)  &kp LA(LC(NON_US_BACKSLASH))  &none             &none  &none
&trans  &kp EQUAL  &kp LS(EQUAL)  &kp LS(NON_US_HASH)    &kp LS(NUMBER_2)   &none                     &kp NON_US_HASH  &kp LS(NUMBER_0)  &kp LS(MINUS)                 &kp LS(NUMBER_1)  &none  &none
&trans  &none      &kp LS(N5)     &kp LS(RIGHT_BRACKET)  &kp RIGHT_BRACKET  &none   &trans    &trans  &none            &kp LS(NUMBER_7)  &kp LA(LC(MINUS))             &kp LA(LC(E))     &none  &kp LA(LC(RIGHT_BRACKET))
                   &trans         &trans                 &trans             &trans  &trans    &trans  &trans           &trans            &trans                        &trans
            >;

            sensor-bindings =
                <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>,
                <&inc_dec_kp UP_ARROW DOWN_ARROW>;
        };

        Navigation {
            display-name = "nav";

            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1  | BT2  |  BT3  |  BT4  |  BT5 |                |      |      |       |      |       |       |
            // |       | INS  | PSCR | GUI   |       |      |                | PGUP |      |   ^   |      |       |       |
            // |       | ALT  | CTRL | SHIFT |       | CAPS |                | PGDN |   <- |   v   |  ->  |  DEL  | BKSPC |
            // |       | UNDO | CUT  | COPY  | PASTE |      |      |  |      |      |      |       |      |       |       |
            //                |      |       |       |      |      |  |      |      |      |       |      |

            bindings = <
&trans     &kp F1     &kp F2    &kp F3        &kp F4     &kp F5                       &kp F6        &kp F7               &kp F8                     &kp F9                 &kp F10    &kp F11
&trans     &kp LC(X)  &kp HOME  &kp UP_ARROW  &kp END    &kp F12                      &kp PG_UP     &kp NUMBER_7         &kp NUMBER_8               &kp NUMBER_9           &kp DOT    &kp F12
&kp LC(A)  &kp LC(C)  &kp LEFT  &kp DOWN      &kp RIGHT  &kp LC(F)                    &kp PG_DN     &mt LSHIFT NUMBER_4  &mt LEFT_CONTROL NUMBER_5  &mt LEFT_ALT NUMBER_6  &kp COMMA  &trans
&trans     &kp LC(V)  &trans    &trans        &kp LC(Y)  &kp LC(T)  &trans    &trans  &kp NUMBER_0  &kp NUMBER_1         &kp NUMBER_2               &kp NUMBER_3           &trans     &trans
                      &trans    &trans        &trans     &trans     &trans    &trans  &trans        &trans               &trans                     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        Window {
            // ----------------------------------------------------------------------------------------------------------------------------
            // | BTCLR  |  BT1    |  BT2    |   BT3   |   BT4   |   BT5   |                  |      |      |       |      |       |       |
            // | EXTPWR | RGB_HUD | RGB_HUI | RGB_SAD | RGB_SAI | RGB_EFF |                  |      |      |       |      |       |       |
            // |        | RGB_BRD | RGB_BRI |         |         |         |                  |      |      |       |      |       |       |
            // |        |         |         |         |         |         | RGB_TOG | |      |      |      |       |      |       |       |
            //                    |         |         |         |         |         | |      |      |      |       |      |

            display-name = "win";
            bindings = <
&ext_power EP_TOG  &none               &none                   &none               &none                    &none                                &none         &none         &none         &none         &none         &none
&kp LA(F4)         &none               &kp LS(LG(LEFT_ARROW))  &kp LG(UP_ARROW)    &kp LS(LG(RIGHT_ARROW))  &studio_unlock                       &none         &none         &none         &none         &none         &none
&kp LC(F4)         &none               &kp LC(LS(TAB))         &kp LG(DOWN_ARROW)  &kp LC(LA(TAB))          &none                                &none         &none         &none         &none         &none         &none
&kp LS(ESCAPE)     &kp LA(LC(DELETE))  &kp LS(LC(PG_UP))       &kp LG(D)           &kp LC(PAGE_DOWN)        &kp LC(T)       &none    &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none
                                       &none                   &none               &none                    &none           &none    &none       &none         &none         &none         &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        aoe {
            bindings = <
&aoeStart     &kp N1     &kp N2  &kp N3  &kp N4     &kp N5                      &kp N6  &kp N7  &kp N8  &kp N9     &kp N0   &none
&kt ESCAPE    &kp P      &kp Q   &kp W   &kp E      &kp R                       &kp T   &kp Y   &kp U   &kp I      &kp O    &kp P
&kp TAB       &kp LSHFT  &kp A   &kp S   &kp D      &kp F                       &kp G   &kp H   &kp J   &kp K      &kp L    &none
&kt LEFT_ALT  &kp LCTRL  &kp Z   &kp X   &kp C      &kp V    &none      &tog 4  &kp B   &kp N   &kp M   &kp COMMA  &kp DOT  &none
                         &none   &none   &kp COMMA  &kp DOT  &lt 5 H    &none   &none   &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        aoe_t {
            bindings = <
&none  &kt LS(NUMBER_1)  &kp LS(N2)  &kp LS(N3)  &kp LS(N4)  &kp LS(N5)                  &kp LS(N6)  &kp LS(N7)  &kp LS(N8)  &kp LS(N9)  &kp LS(N0)  &none
&none  &none             &none       &none       &none       &none                       &none       &none       &none       &none       &none       &none
&none  &none             &none       &none       &none       &kp G                       &none       &none       &none       &none       &none       &none
&none  &none             &none       &none       &none       &kt T       &none    &none  &none       &none       &none       &none       &none       &none
                         &none       &none       &none       &none       &none    &none  &none       &none       &none       &none
            >;
        };
    };
};
